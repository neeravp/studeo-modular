{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": [],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "jsx": "preserve"
    },
    "vueCompilerOptions": {
        "strictTemplates": true
    },
    "include": ["*.ts", "pages/**/*.vue"]
}
