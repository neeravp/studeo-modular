{
    "name": "studeo/modular",
    "description": "Modular architecture and code generators for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "symfony/yaml": "^8.1",
        "nikic/php-parser": "^5",
        "studeo/check": "^0.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0",
        "laravel/pint": "^1.27",
        "livewire/livewire": "^4.0",
        "inertiajs/inertia-laravel": "^3.0",
        "larastan/larastan": "^3.13"
    },
    "suggest": {
        "livewire/livewire": "Required by module:livewire (^4.0): generated components and Forms extend Livewire classes.",
        "inertiajs/inertia-laravel": "Required by module:vue pages and forms and by --inertia controllers (^3.0): generated code renders pages with Inertia::render()."
    },
    "autoload": {
        "psr-4": {
            "Studeo\\Modular\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Studeo\\Modular\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Studeo\\Modular\\Providers\\ModularServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
